{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "baton checkpoint --platform cursor --trigger stop"
      }
    ],
    "afterFileEdit": [
      {
        "command": "baton checkpoint --platform cursor --debounce 120 --trigger afterFileEdit"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "baton checkpoint --platform cursor --trigger beforeShellExecution",
        "matcher": "git commit"
      }
    ],
    "sessionStart": [
      {
        "command": "baton session-start --platform cursor"
      }
    ],
    "preCompact": [
      {
        "command": "baton checkpoint --platform cursor --trigger preCompact"
      }
    ]
  }
}
